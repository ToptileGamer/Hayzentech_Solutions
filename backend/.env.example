# ===================================================
# HayzenTech Solutions - Backend Environment Variables
# ===================================================
# Copy this file to .env and fill in the values.
# On Render, these are set via the dashboard or render.yaml.

# ---- Server ----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ---- Database (Local) ----
# On Render, use DATABASE_URL instead (set automatically via render.yaml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hayzentech
DB_USER=postgres
DB_PASSWORD=your_password_here

# ---- Database (Render) ----
# Uncomment and set this when deploying to Render or using a remote DB
# DATABASE_URL=postgresql://user:password@host:5432/hayzentech

# ---- Authentication ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ---- Razorpay (Payments) ----
# Get these from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# ---- Admin (Default credentials set via db:init) ----
ADMIN_PASSWORD=admin123
